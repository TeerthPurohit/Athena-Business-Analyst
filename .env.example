# Database
DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

# Required for local Athena account JWTs; use a stable random value of at least 32 bytes.
JWT_ACCESS_SECRET=

# BA structured extraction
OPENAI_API_KEY=
OPENAI_BASE_URL=
NVIDIA_LLM_API_KEY=
NVIDIA_LLM_BASE_URL=
LLM_MODEL=
BA_LLM_MODEL=
BA_LLM_FALLBACK_MODEL=
BA_LLM_BASE_URL=
# Chat tier defaults to typesafe/jev-router (BA_LLM_MODEL overrides); Jev Router chooses a
# downstream model and reasoning effort for each request. Deep-reasoning tier (project investigations)
# defaults to xiaomi/mimo-v2.6-pro (BA_ANALYST_MODEL overrides). Each is the other's fallback.
# low | medium | high — latency knob for the reasoning tier (unset = provider default)
BA_LLM_REASONING_EFFORT=
BA_SPAN_SCORING_ENABLED=true
BA_SPAN_MODEL=respan/span-01
BA_SPAN_TIMEOUT_SECONDS=8
# Browser push-to-talk and reply playback use OpenRouter's audio endpoints.
BA_VOICE_STT_MODEL=openai/gpt-transcribe
BA_VOICE_TTS_MODEL=google/gemini-3.8-flash-lite-tts
BA_VOICE_TTS_VOICE=Kore
# Per-run, per-step model cost log (Markdown). Default: <repo>/log.md; set to an empty value to disable.
# BA_COST_LOG_PATH=log.md
# Document parts analyzed at once during upload (each runs two LLM pipelines)
BA_INGEST_CONCURRENCY=4
BA_ANALYST_MODEL=
# Optional separate LLM judge for investigation answer scoring; defaults to the reasoning tier.
BA_EVALUATOR_MODEL=
# Optional Langfuse tracing (free Hobby cloud tier or self-hosted); unset keys = tracing off
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
BA_EMBEDDING_MODEL=
BA_EMBEDDING_DIMENSIONS=
DEEPSEEK_API_KEY=
BA_EXTRACTION_MAX_SOURCE_CHARS=
BA_EXTRACTION_MAX_SPANS_PER_REQUEST=
BA_EXTRACTION_MAX_RETRIES=
BA_EVALUATION_DATASET_PATH=

# Jev classification, clarification, and tool routing via OpenRouter
OPENROUTER_API_KEY=

# Optional BA durable source storage
BA_OBJECT_STORAGE_ENDPOINT=
BA_OBJECT_STORAGE_REGION=
BA_OBJECT_STORAGE_FORCE_PATH_STYLE=
BA_OBJECT_STORAGE_ACCESS_KEY=
BA_OBJECT_STORAGE_SECRET_KEY=
BA_OBJECT_STORAGE_BUCKET=
